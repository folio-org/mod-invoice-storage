#%RAML 1.0
title: Calendar notifications events
version: v1.0
protocols: [ HTTP, HTTPS ]
baseUri: http://github.com/folio-org/mod-invoice-storage

documentation:
  - title: Calendar notifications events
    content: Kafka events exchanged with mod-notification-center for calendar-based notifications

types:
  calendar-trigger-event: !include acq-models/common/schemas/calendar_trigger_event.json
  calendar-trigger-rule: !include acq-models/common/schemas/calendar_trigger_rule.json
  calendar-match-event: !include acq-models/common/schemas/calendar_match_event.json
  calendar-match: !include acq-models/common/schemas/calendar_match.json
